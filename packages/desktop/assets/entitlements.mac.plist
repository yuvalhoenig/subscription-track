<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron needs JIT and unsigned executable memory under the
       hardened runtime; without these the app will not launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- Voice commands. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- Talking to the API. -->
  <key>com.apple.security.network.client</key>
  <true/>

  <!-- Reading subscription confirmations from Mail via AppleScript. macOS
       still prompts the user for consent the first time. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
