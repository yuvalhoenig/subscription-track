{
  "name": "@subtrack/server",
  "version": "1.0.0",
  "private": true,
  "description": "SubTrack REST API, AI engine and background jobs",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:migrate": "NODE_ENV=test node src/db/migrate.js",
    "admin:promote": "node src/db/promote-admin.js",
    "admin:create": "node src/db/create-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@subtrack/shared": "*",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.12"
  }
}
