# ─────────────────────────────────────────────────────────────
# SubTrack environment configuration
# Copy to `.env` and fill in the values you need.
# Everything with a default works out of the box for local dev.
# ─────────────────────────────────────────────────────────────

# ---- Core ----
NODE_ENV=development
PORT=4000
# Public URL of the web app, used in verification / reset emails and CORS
APP_URL=http://localhost:5173
# Comma-separated list of extra allowed CORS origins (Electron uses file://)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---- PostgreSQL ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subtrack
# Set to `require` when talking to a managed Postgres over TLS
PGSSLMODE=disable

# ---- Redis (optional) ----
# Used for caching AI responses, rate limiting and refresh-token revocation.
# If unreachable, SubTrack transparently falls back to an in-process cache.
REDIS_URL=redis://localhost:6379

# ---- Auth ----
# CHANGE THESE. Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0000000000000000
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-000000000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=12

# ---- Anthropic / Claude (powers every AI feature) ----
# Without a key the AI engine runs in "heuristic mode": rule-based NLP,
# statistical forecasting and templated insights. Nothing crashes.
ANTHROPIC_API_KEY=
# Fast + cheap model for parsing/categorisation, stronger model for insights
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MODEL_SMART=claude-sonnet-5
# Per-user ceiling on Claude calls per hour
AI_RATE_LIMIT_PER_HOUR=60
AI_MAX_OUTPUT_TOKENS=2048
AI_CACHE_TTL_SECONDS=900

# ---- Voice transcription (optional) ----
# `openai` uses Whisper; `native` lets the client do it (macOS / Web Speech API)
VOICE_PROVIDER=native
OPENAI_API_KEY=

# ---- Receipt OCR ----
# tesseract.js runs locally with no external service. Set to `off` to disable.
OCR_PROVIDER=tesseract
OCR_MAX_UPLOAD_MB=8

# ---- Email (verification, password reset, renewal reminders) ----
# Leave SMTP_HOST empty in dev: mails are logged to the console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SubTrack <no-reply@subtrack.app>"

# ---- Background jobs ----
# Renewal reminders + nightly insight generation (node-cron syntax, UTC)
ENABLE_SCHEDULER=true
CRON_REMINDERS=*/15 * * * *
CRON_NIGHTLY_INSIGHTS=0 3 * * *

# ---- Demo / seed ----
DEMO_EMAIL=demo@subtrack.app
DEMO_PASSWORD=DemoPass123!

# ---- Web app (Vite; must be prefixed with VITE_) ----
VITE_API_URL=http://localhost:4000
