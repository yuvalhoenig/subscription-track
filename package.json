{
  "name": "subtrack",
  "version": "1.0.0",
  "private": true,
  "description": "SubTrack - AI-powered subscription management platform (web + macOS desktop)",
  "license": "MIT",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/web",
    "packages/desktop"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --workspace @subtrack/server",
    "dev:web": "npm run dev --workspace @subtrack/web",
    "dev:desktop": "npm run dev --workspace @subtrack/desktop",
    "build": "npm run build --workspace @subtrack/web",
    "build:desktop": "npm run build --workspace @subtrack/web && npm run build --workspace @subtrack/desktop",
    "db:migrate": "npm run db:migrate --workspace @subtrack/server",
    "db:seed": "npm run db:seed --workspace @subtrack/server",
    "db:reset": "npm run db:reset --workspace @subtrack/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1"
  }
}
